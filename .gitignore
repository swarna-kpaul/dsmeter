# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Recorded CPOT traces (runtime output; keep them out of the repo)
*.jsonl
!tests/**/*.jsonl
!examples/**/*.jsonl

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Type checkers
.mypy_cache/
.pyre/
.ruff_cache/
